# Copy to .env and fill in. Never commit .env.

# --- Core ---
ENV=dev                       # dev | staging | prod
JWT_SECRET=change-me-long-random
# Dedicated signing secret for ADMIN tokens. REQUIRED outside dev, and must
# differ from JWT_SECRET (the API refuses to boot otherwise) — a leaked
# user/listener secret must not forge admin access.
ADMIN_JWT_SECRET=
# Dedicated signing secret for MENTOR (listener console) tokens. REQUIRED outside
# dev, distinct from JWT_SECRET and ADMIN_JWT_SECRET (boot refuses otherwise).
LISTENER_JWT_SECRET=
# Claim-less tokens minted before the iss/aud/jti change stay valid until this
# date. Must be >= (day that change reaches prod + JWT_TTL_DAYS). Default 2027-01-31.
#LEGACY_CLAIMS_ACCEPTED_UNTIL=2027-01-31
MIN_AGE=18                    # age gate (Trust & Safety: recommend 18)

# --- Public web origins + CORS (the web build calls the API cross-origin) ---
# APP_BASE_URL   = the one web app (member + mentor sides, /apply, sign-in links)
# ADMIN_BASE_URL = the staff dashboard's own origin
# Links the API mints are built from these. Hostnames live in deploy/domains.env;
# prod: https://app.<root> and https://admin.<root>.
APP_BASE_URL=http://localhost:8081
ADMIN_BASE_URL=http://localhost:8081
# Comma-separated browser origins allowed outside dev. Dev uses a wildcard. If
# unset outside dev, the API derives the two origins above (and logs a warning) —
# set it explicitly for staging/prod.
CORS_ORIGINS=
# DEPRECATED — fallback for both URLs above when they are empty. Remove once prod
# sets APP_BASE_URL + ADMIN_BASE_URL.
CONSOLE_BASE_URL=http://localhost:8081

# --- Postgres ---
# Default = the local docker-compose Postgres (`docker compose up -d`); dev and
# tests share this engine. In staging/prod, point at DigitalOcean Managed Postgres
# (App Platform path, see docs/DEPLOYMENT.md) OR a self-managed container
# (VPS path, see docs/DEPLOYMENT_VPS.md — deploy/docker-compose.prod.yml reads
# POSTGRES_PASSWORD below to build DATABASE_URL itself; this line is then unused).
DATABASE_URL=postgresql+psycopg://mento:mento@localhost:5432/mento
# VPS path only: password for the self-managed Postgres container. Required by
# deploy/docker-compose.prod.yml; ignored everywhere else.
#POSTGRES_PASSWORD=
# Balanced stack only (T1.7): the GlitchTip error tracker's Django SECRET_KEY —
# openssl rand -hex 32. Required by deploy/compose.prod.yml; ignored everywhere
# else. Not the same secret as SENTRY_DSN below (that's GlitchTip's own output,
# generated once you've stood it up — see docs/DEPLOYMENT_VPS.md).
#GLITCHTIP_SECRET_KEY=

# --- DB pool sizing (per uvicorn worker process) ---
# Formula: UVICORN_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) x containers
# must stay UNDER Postgres max_connections. DigitalOcean Managed Postgres
# (1GB) allows ~97 connections, minus ~3 reserved — budget for ~90.
# App defaults (config.py) are 20+20, sized for one local dev process.
# Container defaults (Dockerfile) are conservative: 2 workers x (5+5) = 20.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5
# Uvicorn worker count in the container (see Dockerfile / docker-entrypoint.sh).
#UVICORN_WORKERS=2

# --- Redis (presence, matching queue, rate limits) ---
REDIS_URL=redis://localhost:6379/0
# Trusted reverse-proxy hops for rate-limit client identity. 0 = ignore
# X-Forwarded-For entirely (it is attacker-writable); set to 1 behind a single
# load balancer, etc. REQUIRED (explicitly, even as 0) outside dev.
TRUSTED_PROXY_HOPS=0

# --- Stream Chat (messages stored server-side; "Panda Wipe" = real server delete) ---
STREAM_API_KEY=
STREAM_API_SECRET=

# --- Razorpay (transparent contributions only; NO membership tiers) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- PostHog (never send message content or PII) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Sentry (empty = Sentry off; errors only, request bodies stripped) ---
SENTRY_DSN=

# Push notifications (spec 2026-09-05): false = register tokens but never send.
PUSH_ENABLED=true

# --- Crisis helplines (verify current India numbers at build: Tele-MANAS / KIRAN) ---
# JSON array of {name, number, hours}
CRISIS_HELPLINES_JSON=[{"name":"Tele-MANAS","number":"14416","hours":"24x7"},{"name":"KIRAN","number":"1800-599-0019","hours":"24x7"}]

# --- Member message allowance (DECISIONS L.2) ---
# Counting is always on (composer meter + admin numbers). HOLDING starts only when
# ALLOWANCE_ENFORCED=true - flip it once the shipped app renders the A22 note. A message
# the crisis scan flags is never held and never counted, whatever these say.
ALLOWANCE_ENABLED=true
ALLOWANCE_ENFORCED=false
ALLOWANCE_IN_A_ROW=3
ALLOWANCE_PER_DAY=10
ALLOWANCE_CRISIS_EXEMPT_HOURS=24

# --- Rotating mentor names + stay in touch (DECISIONS L.6-7) ---
# Names change at 04:00 IST. false = names stay as they are.
MENTOR_NAME_ROTATION_ENABLED=true
IN_TOUCH_LIMIT=2
IN_TOUCH_REASK_DAYS=7

# --- Mentor Snooze (DECISIONS L.9, board A10) ---
# How long "Snooze 24 h" quiets one waiting conversation (no pushes, no stale sweep).
SNOOZE_HOURS=24
