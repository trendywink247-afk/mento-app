# The public status page (Uptime Kuma), reverse-proxied from a container on
# 127.0.0.1:3001. Lives on the OLD box (87.232.72.79), deliberately separate
# from the new prod box it watches — see PROGRESS.md 2026-09-27. Not part of
# render-nginx.sh's templated app/api/admin set: this is a one-off service,
# installed by hand per docs/DEPLOYMENT_VPS.md's certbot pattern.
server {
    listen 443 ssl;
    server_name status.mento.chat;

    ssl_certificate /etc/letsencrypt/live/status.mento.chat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.mento.chat/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Live member/mentor/conversation counts — a small static page, not part of
    # Uptime Kuma (its JSON-query monitor type does equality checks, not numeric
    # gauges, so it can't show a live count sensibly). Fetches /status/public
    # directly from the browser.
    location = /live {
        root /opt/mento-status;
        try_files /counts.html =404;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name status.mento.chat;
    return 301 https://$host$request_uri;
}
