# Nginx reverse proxy for the Mento API — host-level config (not containerized).
# Copy to /etc/nginx/sites-available/mento-api.conf, replace API_DOMAIN, then:
#   sudo ln -s /etc/nginx/sites-available/mento-api.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d API_DOMAIN     # provisions TLS + rewrites this file's server block

server {
    listen 80;
    server_name API_DOMAIN;

    client_max_body_size 5m;

    location /api/v1/health {
        proxy_pass http://127.0.0.1:8000;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
