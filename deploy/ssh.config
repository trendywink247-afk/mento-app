# Repository-scoped access. Existing private keys stay in the user's SSH directory.
# VPS B retained its verified host key when the provider changed its IP.
Host mento-production
    HostName 129.121.122.28
    HostKeyAlias 129.121.122.28
    User mento-ops
    IdentityFile ~/.ssh/mento_prod_agent
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 10

Host mento-staging
    HostName 31.42.125.238
    HostKeyAlias 87.232.72.79
    User mento-ops
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 10
