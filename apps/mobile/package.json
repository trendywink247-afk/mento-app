{
  "name": "mento-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:route": "tsc lib/notificationRoute.ts --outDir .tmp-route --module es2020 --target es2020 --skipLibCheck && node e2e/notifications-route.test.mjs",
    "test:question": "tsc lib/questionBuilder.ts --outDir .tmp-question --module es2020 --target es2020 --skipLibCheck && node e2e/question-builder.test.mjs",
    "test:placement": "tsc lib/companionPlacement.ts --outDir .tmp-placement --module es2020 --target es2020 --skipLibCheck && node e2e/companion-placement.test.mjs",
    "test:bubble": "tsc components/chat/streamTheme.ts --outDir .tmp-bubble --module es2020 --target es2020 --skipLibCheck && node e2e/bubble-theme.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.6.5",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "^55",
    "expo-asset": "~55.0.20",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-video": "~55.0.21",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "~7.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-teleport": "1.2.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.12.2",
    "stream-chat": "^9.45.2",
    "stream-chat-expo": "^9.3.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~55.0.11",
    "@types/react": "~19.2.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-safe-area-context": "~5.6.0",
    "stream-chat-react-native-core": {
      "lodash-es": "4.18.1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@expo/config-plugins",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
