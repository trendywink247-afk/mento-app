{
  "name": "mento-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:route": "tsc lib/notificationRoute.ts --outDir .tmp-route --module es2020 --target es2020 --skipLibCheck && node e2e/notifications-route.test.mjs",
    "test:question": "tsc lib/questionBuilder.ts --outDir .tmp-question --module es2020 --target es2020 --skipLibCheck && node e2e/question-builder.test.mjs",
    "test:placement": "tsc lib/companionPlacement.ts --outDir .tmp-placement --module es2020 --target es2020 --skipLibCheck && node e2e/companion-placement.test.mjs",
    "test:bubble": "tsc components/chat/streamTheme.ts --outDir .tmp-bubble --module es2020 --target es2020 --skipLibCheck && node e2e/bubble-theme.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@lottiefiles/dotlottie-react": "^0.6.5",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@sentry/react-native": "~6.14.0",
    "@shopify/react-native-skia": "v2.0.0-next.4",
    "expo": "^53",
    "expo-asset": "~11.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-manipulator": "~13.1.7",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sensors": "~14.1.4",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "expo-video": "~2.2.2",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-teleport": "1.1.8",
    "react-native-web": "^0.20.0",
    "stream-chat": "^9.45.2",
    "stream-chat-expo": "^9.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react-native-safe-area-context": "5.4.0"
  },
  "private": true
}
