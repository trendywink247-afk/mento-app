{
  "name": "mento-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:route": "tsc lib/notificationRoute.ts --outDir .tmp-route --module es2020 --target es2020 --skipLibCheck && node e2e/notifications-route.test.mjs",
    "test:question": "tsc lib/questionBuilder.ts --outDir .tmp-question --module es2020 --target es2020 --skipLibCheck && node e2e/question-builder.test.mjs",
    "test:placement": "tsc lib/companionPlacement.ts --outDir .tmp-placement --module es2020 --target es2020 --skipLibCheck && node e2e/companion-placement.test.mjs",
    "test:bubble": "tsc components/chat/streamTheme.ts --outDir .tmp-bubble --module es2020 --target es2020 --skipLibCheck && node e2e/bubble-theme.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@lottiefiles/dotlottie-react": "^0.6.5",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.9.0",
    "@sentry/react-native": "~6.10.0",
    "@shopify/react-native-skia": "1.5.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.1",
    "expo-media-library": "~17.0.6",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sensors": "~14.0.2",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.5",
    "expo-video": "~2.0.6",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "7.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-teleport": "1.1.8",
    "react-native-web": "~0.19.13",
    "stream-chat": "^9.45.2",
    "stream-chat-expo": "^9.3.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "react-native-safe-area-context": "4.12.0"
  },
  "private": true
}
