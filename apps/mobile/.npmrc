# reason: stream-chat-react-native-core peers react-native-safe-area-context >=5.4.1,
# but Expo SDK 52 pins 4.12.0 (Expo Go ships its native half). Without this flag npm
# auto-installs a nested 5.8.0 copy, which double-registers RNCSafeAreaProvider and
# crashes every native screen. Expo owns the dependency matrix; peers stay manual.
legacy-peer-deps=true
