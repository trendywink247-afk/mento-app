# Copy to .env. Expo inlines EXPO_PUBLIC_* at build time.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_STREAM_API_KEY=
# Anonymous funnel analytics (lib/analytics.ts) — empty key = fully dark, zero requests.
EXPO_PUBLIC_POSTHOG_KEY=
# Ingestion host; when unset the code defaults to https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
