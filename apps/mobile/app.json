{
  "expo": {
    "name": "Mento",
    "slug": "mento",
    "scheme": "mento",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F4FB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mento.app"
    },
    "android": {
      "package": "com.mento.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F4FB"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-video",
      "expo-font",
      "@sentry/react-native",
      "expo-localization",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#5847D6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
