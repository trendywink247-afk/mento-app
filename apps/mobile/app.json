{
  "expo": {
    "name": "Mento",
    "slug": "mento",
    "scheme": "mento",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "chat.mento.app"
    },
    "android": {
      "package": "chat.mento.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png",
        "backgroundColor": "#F4EFE6"
      },
      "versionCode": 12,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "@sentry/react-native",
      "expo-localization",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#A2533A",
          "icon": "./assets/icon/notification-icon.png",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon/icon.png"
  }
}
